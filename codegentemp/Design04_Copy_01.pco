# Design04_Copy_01
# 2026-10-29 11:26:09Z

# IO_2@[IOP=(3)][IoId=(2)] is reserved: SWDDebugEnabled
dont_use_io iocell 3 2
# IO_3@[IOP=(3)][IoId=(3)] is reserved: SWDDebugEnabled
dont_use_io iocell 3 3
set_location "ClockGenBlock" m0s8clockgenblockcell -1 -1 0
set_location "ClockBlock" m0s8clockblockcell -1 -1 0
set_io "Pin_Main(0)" iocell 0 2
set_io "Pin_ISR(0)" iocell 0 3
set_io "Button(0)" iocell 0 7
set_location "\Timer_1:cy_m0s8_tcpwm_1\" m0s8tcpwmcell -1 -1 0
set_location "isr_Timer" interrupt -1 -1 16
set_location "isr_Button" interrupt -1 -1 0
